# ==============================================
# e-Haat Environment Configuration Template
# ==============================================

# FRONTEND CONFIGURATION
# Allowed frontend URLs for CORS (comma-separated if multiple, no trailing slash)
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173

# Ports for Docker Compose
FRONTEND_PORT=80
BACKEND_PORT=8080

# Optional: If client is hosted on a different domain than server, specify full backend URL
# Leave empty if using Docker Compose Nginx reverse-proxy setup
VITE_API_BASE_URL=

# BACKEND CONFIGURATION
PORT=8080
NODE_ENV=production

# JWT Authentication
ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key_change_in_production
ACCESS_TOKEN_EXPIRY=5h
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key_change_in_production
REFRESH_TOKEN_EXPIRY=5d

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/e-haat?retryWrites=true&w=majority

# Resend Email Service
RESEND_API=your_resend_api_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
